PORT=8787
# HTTPS ters vekilinin arkasinda 1 olmali.
SECURE_COOKIES=1
# Expo projesinde Android FCM / iOS APNs kimlikleri kurulduktan sonra ac.
EXPO_PUSH_ENABLED=0
# Expo Push Security etkinse token burada, kaynak kodda degil.
EXPO_ACCESS_TOKEN=

# Kalici disk dizini (Railway volume ile ayni yol).
DATA_DIR=./data


# 3.3: güvenilir HTTPS kökü. Şifre yenileme bağlantısı Host başlığından üretilmez.
PUBLIC_APP_URL=https://ikimiz-production-17d04203.up.railway.app
# E-posta için EMAIL_FROM + RESEND_API_KEY veya TLS SMTP bilgileri gerekir.
EMAIL_FROM=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# VAPID anahtarlarını yalnızca bir kez üret; güncellemede mevcut anahtarları koru.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://ikimiz-production-17d04203.up.railway.app
AUTO_BACKUP_ENABLED=1
BACKUP_RETENTION=3
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=auto
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_FORCE_PATH_STYLE=false
# 32 bayt rastgele anahtar, 64 hex karakter. Ayrı güvenli yerde yedeklenmelidir.
BACKUP_ENCRYPTION_KEY=
